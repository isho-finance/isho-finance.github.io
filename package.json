{
  "name": "gatsby-emotion-tailwind-starter",
  "description": "A starter Gatsby site which includes Emotion and Tailwind",
  "version": "3.1.2",
  "author": "Chris Williams",
  "repository": "https://github.com/chrismwilliams/gatsby-emotion-tailwind-starter",
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@fontsource/open-sans": "^5.0.0",
    "@fortawesome/fontawesome-svg-core": "^6.4.0",
    "@fortawesome/free-brands-svg-icons": "^6.4.0",
    "@fortawesome/free-solid-svg-icons": "^6.4.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "dotenv": "^16.0.0",
    "gatsby": "^5.13.0",
    "gatsby-plugin-emotion": "^8.14.0",
    "gatsby-plugin-google-analytics": "^5.13.0",
    "gatsby-plugin-image": "^3.13.0",
    "gatsby-plugin-manifest": "^5.13.0",
    "gatsby-plugin-offline": "^6.13.0",
    "gatsby-plugin-postcss": "^6.13.0",
    "gatsby-plugin-purgecss": "^6.1.2",
    "gatsby-plugin-react-helmet": "^6.13.0",
    "gatsby-plugin-sharp": "^5.13.0",
    "gatsby-plugin-sitemap": "^6.13.0",
    "gatsby-source-filesystem": "^5.13.0",
    "gatsby-transformer-sharp": "^5.13.0",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "tailwindcss": "^3.3.0",
    "twin.macro": "^3.0.0"
  },
  "devDependencies": {
    "ajv": "^8.12.0",
    "autoprefixer": "^10.4.0",
    "babel-preset-gatsby": "^3.13.0",
    "cssnano": "^6.0.0",
    "prettier": "^3.0.0"
  },
  "babelMacros": {
    "twin": {
      "preset": "emotion"
    }
